# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Firebase Web App config ──────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps → Web app
# (Project: bappy-app → bappy-app.web.app)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=bappy-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bappy-app
VITE_FIREBASE_STORAGE_BUCKET=bappy-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Legacy (no longer used — kept for reference) ─────────────────────────────
# VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
